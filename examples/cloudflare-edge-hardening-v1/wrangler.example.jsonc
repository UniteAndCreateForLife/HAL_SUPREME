{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hal-chat",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-23",
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "REPLACE_WITH_UNIQUE_POSITIVE_INTEGER",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "HEAVY_RATE_LIMITER",
      "namespace_id": "REPLACE_WITH_DIFFERENT_POSITIVE_INTEGER",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "vars": {
    "HAL_ALLOWED_ORIGINS": "https://halsupreme.com,https://www.halsupreme.com",
    "HAL_REQUIRE_TURNSTILE": "1",
    "HAL_EDGE_FALLBACK_ENABLED": "0",
    "HAL_EDGE_FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  }
}
