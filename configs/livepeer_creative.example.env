# HAL Livepeer Agent Creative MCP
# Safe endpoint configuration. Do not commit real credentials.
LIVEPEER_CREATIVE_MCP_URL=https://agent.livepeer.org/api/mcp/creative

# Optional only if the authenticated Livepeer connection gives HAL a bearer.
# Prefer the provider's normal MCP authentication flow when possible.
LIVEPEER_MCP_BEARER=

# Router registration is opt-in. A keyless/demo MCP connection is discovery-only
# and must never be admitted as sponsored or zero-spend production capacity.
HAL_PROVIDER_LIVEPEER_CREATIVE_ENABLED=false
HAL_PROVIDER_LIVEPEER_CREATIVE_AUTHENTICATED=false
HAL_PROVIDER_LIVEPEER_CREATIVE_ZERO_SPEND_READY=false
HAL_PROVIDER_LIVEPEER_CREATIVE_SPONSORSHIP_VERIFIED=false

# Set AUTHENTICATED=true only after the provider/account identity has been
# independently verified. Set ZERO_SPEND_READY=true only after the current
# price/cap/balance has also been verified. Set SPONSORSHIP_VERIFIED=true only
# when authenticated provider evidence explicitly identifies the balance as a
# sponsor/grant entitlement; a demo allowance is not a grant.
