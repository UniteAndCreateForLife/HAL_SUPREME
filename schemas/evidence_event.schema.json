{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halsupreme.com/schemas/evidence_event.schema.json",
  "title": "HAL Evidence Event",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "seq",
    "ts_utc",
    "elapsed_ms",
    "kind",
    "source",
    "message",
    "data",
    "prev_hash",
    "event_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ts_utc": {
      "type": "string",
      "format": "date-time"
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "prev_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
